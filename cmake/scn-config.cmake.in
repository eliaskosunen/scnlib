@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if (NOT @SCN_FAST_FLOAT_BUNDLED@ AND NOT @SCN_DISABLE_FAST_FLOAT@)
    find_dependency(FastFloat)
endif ()

if (NOT @SCN_EKNAN_BUNDLED@ AND NOT @SCN_DISABLE_EKNAN@)
    find_dependency(eknan 0.1.0)
endif ()

if (NOT @SCN_DISABLE_REGEX@ AND (@SCN_REGEX_BACKEND@ STREQUAL "Boost") AND @SCN_USE_EXTERNAL_REGEX_BACKEND@)
    find_dependency(Boost COMPONENTS regex)

    if (@SCN_REGEX_BOOST_USE_ICU@)
        find_dependency(ICU COMPONENTS data i18n uc)
    endif ()
endif ()

if (NOT @SCN_DISABLE_REGEX@ AND (@SCN_REGEX_BACKEND@ STREQUAL "re2") AND @SCN_USE_EXTERNAL_REGEX_BACKEND@)
    find_dependency(re2)
endif ()

check_required_components(scn)

if (TARGET scn::scn)
    return()
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/scn-targets.cmake")
